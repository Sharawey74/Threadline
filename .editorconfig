# Byte-exactness starts here. The write-back path preserves whatever bytes it
# reads, and the round-trip gate compares files byte for byte - so an editor
# that trims whitespace or swaps line endings can fail CI for reasons that have
# nothing to do with the code.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,html,yml,yaml}]
indent_size = 2

[*.go]
indent_style = tab

[*.md]
# Markdown gives meaning to trailing spaces, and the plan file is parsed
# byte for byte. Never strip them here.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[testdata/crlf/**]
# Fixtures that exist to prove line endings survive write-back.
end_of_line = crlf
insert_final_newline = false
